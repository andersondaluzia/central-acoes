{
  "name": "Central de Ações",
  "short_name": "Ações",
  "description": "Captura rápida e controle de ações, projetos e demandas pessoais.",
  "id": "./",
  "start_url": "./#captura",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#2453d4",
  "lang": "pt-BR",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Ação pessoal", "short_name": "Pessoal", "url": "./#captura/pessoal", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Ação de trabalho", "short_name": "Trabalho", "url": "./#captura/trabalho", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Cobrar hoje", "short_name": "Hoje", "url": "./#hoje", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
